# ===============================================
# Open Grok Bot - Configuration
# ===============================================

# LLM Provider: 'groq', 'ollama', or 'openai' (default: groq)
LLM_PROVIDER=groq

# Groq API Key (Free, get one at https://console.groq.com)
GROQ_API_KEY=gsk_your_groq_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Ollama (if LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.2

# OpenAI / Compatible fallback (if LLM_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Telegram Bot Token (Optional, get from @BotFather on Telegram)
TELEGRAM_BOT_TOKEN=

# Allowed Telegram Chat IDs (comma-separated, leave empty to allow all or ask on first start)
TELEGRAM_ALLOWED_USERS=

# Browser Settings
BROWSER_HEADLESS=true
BROWSER_TIMEOUT=30000

# Storage
DATABASE_PATH=data/open_grok.db
WORKSPACE_DIR=workspace_output
